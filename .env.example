# Server Configuration
PORT=4000
NODE_ENV=development

# LLM Provider Configuration (Optional - Offline deterministic mode active by default)
# You can supply any supported provider key:
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=

# Open-Meteo Configuration (Free, No API key required)
OPEN_METEO_GEOCODING_URL=https://geocoding-api.open-meteo.com/v1/search
OPEN_METEO_FORECAST_URL=https://api.open-meteo.com/v1/forecast
